# MySQL connection. Keep the real values in .env only.
DB_HOST=your-mysql-host.example.com
DB_PORT=3306
DB_NAME=japanese_learning
DB_USER=japanese_app
DB_PASSWORD=replace-with-a-strong-password
DB_SSL=true
# Optional: path to the CA certificate required by your MySQL provider.
DB_SSL_CA_PATH=
# Keep true when a trusted CA is configured. Set false only for a self-signed
# server you control when certificate verification is not currently possible.
DB_SSL_REJECT_UNAUTHORIZED=true

# API server
API_HOST=127.0.0.1
API_PORT=3001
SESSION_DAYS=30
ALLOW_REGISTRATION=true
# Comma-separated public origins, without a trailing slash.
# Production example: https://learn.example.com,https://www.learn.example.com
APP_ORIGINS=
# Canonical public address of the website.
APP_PUBLIC_URL=
# Production cookies require HTTPS. Keep true for a public deployment.
COOKIE_SECURE=true
# Enable only when Express is directly behind a trusted reverse proxy.
TRUST_PROXY=false

# Used only by `npm run db:init` to create or update the first account.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=replace-with-a-strong-login-password
ADMIN_DISPLAY_NAME=明子
ADMIN_RECOVERY_KEYWORD=replace-with-a-private-recovery-phrase
